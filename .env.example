# Set this to the public origin serving PLAYORA. For local development:
PUBLIC_BASE_URL=http://localhost:3000

# Temporary OneClick hosted payment link. Replace with a fresh valid link when it expires.
# Payment links are single-use and have a fixed amount; the checkout total must match it.
ONECLICK_PAYMENT_URL=

# Required for signing seller login tokens. Use a long random value in .env.
JWT_SECRET=

# Required by database/reset_admin.js when initializing the seller account.
SELLER_USERNAME=charaf_ben
SELLER_PASSWORD=

# Optional Google buyer sign-in. Create a Google OAuth web app and register its callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to send account and checkout verification codes through Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM=GloboTV <your-verified-sender@example.com>

# Required for checkout OTP delivery through WhatsApp Cloud API.
# Create and get approval for an AUTHENTICATION template with a copy-code button.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=

# PostgreSQL: set DATABASE_URL, or use the individual DB_* settings below.
# On Render, choose Internal Database URL for a same-region web service;
# otherwise use External Database URL and set DB_SSL=true if TLS is required.
DATABASE_URL=
DB_SSL=false
#DB_HOST=...
#DB_PORT=5432
#DB_NAME=...
#DB_USER=...
#DB_PASSWORD=...
