# Set this to the public origin serving PLAYORA. For local development:
PUBLIC_BASE_URL=http://localhost:3000

# PayPal Checkout credentials. Start with Sandbox credentials from
# developer.paypal.com/dashboard/applications, then switch to Live after testing.
GloboTV_ENV=sandbox
GloboTV_CLIENT_ID=
GloboTV_CLIENT_SECRET=

# Optional: set this to the mounted persistent-disk directory for product images on Render.
# Example when the disk mount path is /var/data: PRODUCT_UPLOAD_DIR=/var/data/products
PRODUCT_UPLOAD_DIR=

# Optional Cloudinary image storage. When all three values are set, new product
# uploads are stored in Cloudinary instead of the local filesystem.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for signing seller login tokens. Use a long random value in .env.
JWT_SECRET=

# Required by database/reset_admin.js when initializing the seller account.
SELLER_USERNAME=charaf_ben
SELLER_PASSWORD=

# Optional Google buyer sign-in. Create a Google OAuth web app and register its callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to send account and checkout verification codes through Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM=GloboTV <your-verified-sender@example.com>

# Required for checkout OTP delivery through WhatsApp Cloud API.
# Create and get approval for an AUTHENTICATION template with a copy-code button.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=

# PostgreSQL: set DATABASE_URL, or use the individual DB_* settings below.
# On Render, choose Internal Database URL for a same-region web service;
# otherwise use External Database URL and set DB_SSL=true if TLS is required.
DATABASE_URL=
DB_SSL=false
#DB_HOST=...
#DB_PORT=5432
#DB_NAME=...
#DB_USER=...
#DB_PASSWORD=...
